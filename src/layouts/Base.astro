---
// 머리. 메타, 폰트, 임계 CSS, 상태 인라인 스크립트. 제작 도구 표기는 넣지 않는다.
import '../styles/global.css';
import { show } from '../content/show';
import { readFileSync } from 'node:fs';
interface Props { title?: string; description?: string; noindex?: boolean; variant?: 'a' | 'b' }
const { title = show.meta.title, description = show.meta.description, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
let manifest: { made: Record<string, { range: string }>; titleB64: string; titleRange: string } | null = null;
try { manifest = JSON.parse(readFileSync(new URL('../../public/fonts/manifest.json', import.meta.url), 'utf8')); } catch { manifest = null; }
const face = (name: string, weight: number, display = 'swap') => manifest?.made[`seagull-${name}-${weight}.woff2`]
  ? `@font-face{font-family:'Seagull Serif';font-weight:${weight};font-display:${display};src:url('${base}/fonts/seagull-${name}-${weight}.woff2') format('woff2');unicode-range:${manifest.made[`seagull-${name}-${weight}.woff2`].range}}`
  : '';
const titleFace = manifest ? `@font-face{font-family:'Seagull Title';font-weight:700;font-display:block;src:url(data:font/woff2;base64,${manifest.titleB64}) format('woff2');unicode-range:${manifest.titleRange}}` : '';
const fontCss = [titleFace, face('hero', 400), face('hero', 700), face('rest', 400), face('rest', 700)].join('');
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {siteUrl && <meta property="og:url" content={`${siteUrl}${base}/`} />}
    {siteUrl && <meta property="og:image" content={`${siteUrl}${base}/${show.meta.ogImage}`} />}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    {manifest && <link rel="preload" as="font" type="font/woff2" href={`${base}/fonts/seagull-hero-700.woff2`} crossorigin />}
    {manifest && <link rel="preload" as="font" type="font/woff2" href={`${base}/fonts/seagull-hero-400.woff2`} crossorigin />}
    <style set:html={fontCss}></style>
    <script is:inline>
      // 첫 페인트 전에 상태를 미리 정한다. 날짜별 판정은 진입 모듈이 다시 한다
      (function(){var d=document.documentElement;d.classList.add('js');if(matchMedia('(prefers-reduced-motion: reduce)').matches)d.classList.add('reduced');})();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
