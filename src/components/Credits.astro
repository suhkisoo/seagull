---
// 끝. 만든 사람들, 단체와 표기, 링크. 가장 어두운 초록. docs/plan.md 2.1 "끝", 9.5.3.
import { show } from '../content/show';
---
<section class="section section--credits" id="credits" data-light="credits" aria-labelledby="credits-title">
  <div class="wrap grid">
    <hr class="rule rule--section" />
    <header class="section__head">
      <h2 class="section__title" id="credits-title" tabindex="-1">만든 사람들</h2>
    </header>
    <div class="section__body">
      <dl class="crew">
        {show.crew.map((t) => (
          <div class="crew__row">
            <dt>{t.team}</dt>
            <dd>{t.members.map((m, i) => <span>{i > 0 && ', '}{m.name}{m.title && m.title !== t.team && m.title !== `${t.team}팀원` ? <span class="crew__title">({m.title})</span> : ''}</span>)}</dd>
          </div>
        ))}
      </dl>
      <div class="colophon">
        <!-- 판권면. 기획과 연출은 위 명단에, 일정과 극장은 일정 구간에 있으므로 되풀이하지 않는다(10/17). 작가는 여기에만 -->
        <p>{show.credits.author}</p>
        <p>{show.company}</p>
        {(show.links.instagram || show.links.contact) && <ul class="action-list" role="list">
            {show.links.instagram && <li><span class="action-list__label">인스타그램</span><span class="action-list__value"><a class="action" href={show.links.instagram} target="_blank" rel="noopener">인스타그램 열기</a></span></li>}
            {show.links.contact && <li><span class="action-list__label">문의</span><span class="action-list__value">{show.links.contact.includes('@') ? <a class="action" href={`mailto:${show.links.contact}`}>문의하기</a> : <span>{show.links.contact}</span>}</span></li>}
        </ul>}
        {show.sponsors && <p>{show.sponsors}</p>}
        {show.credits.painting && <p class="colophon__painting">{show.credits.painting}</p>}
        <p class="colophon__title" data-end-title>〈{show.title}〉</p>
      </div>
    </div>
  </div>
</section>
