---
// 끝. 만든 사람들, 단체와 표기, 링크. 가장 어두운 초록. docs/plan.md 2.1 "끝", 9.5.3.
import { show } from '../content/show';
import Icon from './Icon.astro';
---
<section class="section section--credits" id="credits" data-light="credits" aria-labelledby="credits-title">
  <div class="wrap grid">
    <hr class="rule rule--section" />
    <header class="section__head">
      <h2 class="section__title" id="credits-title" tabindex="-1">만든 사람들</h2>
    </header>
    <div class="section__body">
      <dl class="crew">
        {show.crew.map((t) => (
          <div class="crew__row">
            <dt>{t.team}</dt>
            <dd>{t.members.map((m, i) => <span>{i > 0 && ', '}{m.name}{m.title && m.title !== t.team && m.title !== `${t.team}팀원` ? <span class="crew__title">({m.title})</span> : ''}</span>)}</dd>
          </div>
        ))}
      </dl>
      <div class="colophon">
        <!-- 판권면. 기획과 연출은 위 명단에, 일정과 극장은 일정 구간에 있으므로 되풀이하지 않는다(10/17). 작가는 여기에만 -->
        <p>{show.credits.author}</p>
        <p>{show.company}</p>
        <!-- 인스타그램(제 색), 전화, 메일. 글자 대신 아이콘 셋(10/19 연출). 누르면 새 창, 전화, 메일 쓰기 -->
        {(show.links.instagram || show.booking.contact || show.links.contact) && (
          <ul class="icons colophon__icons" role="list" aria-label="연락">
            {show.links.instagram && <li><a class="icon-btn" href={show.links.instagram} target="_blank" rel="noopener" aria-label="인스타그램 열기" title="인스타그램"><Icon name="instagram" /></a></li>}
            {show.booking.contact && <li><a class="icon-btn" href={`tel:${show.booking.contact.replace(/\D/g, '')}`} aria-label={`전화 걸기 ${show.booking.contact}`} title={show.booking.contact}><Icon name="phone" /></a></li>}
            {show.links.contact && <li><a class="icon-btn" href={`mailto:${show.links.contact}`} aria-label={`메일 보내기 ${show.links.contact}`} title={show.links.contact}><Icon name="mail" /></a></li>}
          </ul>
        )}
        {show.sponsors && <p>{show.sponsors}</p>}
        {show.credits.painting && <p class="colophon__painting">{show.credits.painting}</p>}
        <p class="colophon__title" data-end-title>〈{show.title}〉</p>
      </div>
    </div>
  </div>
</section>
