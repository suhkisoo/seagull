---
// 아이콘 하나. 선 아이콘은 글자색(currentColor), 상표 아이콘(인스타그램, 네이버, 카카오)은 제 색(10/19 연출 "색감이 있어야 이해가 된다").
// 연출 지시로 오시는 길과 판권면의 글자 버튼을 아이콘으로 바꿨다(계획서 9.5.16). 뜻은 aria-label과 title로 준다
const { name } = Astro.props as { name: keyof typeof icons };
const icons = {
  instagram: '<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><defs><linearGradient id="ig" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#F9CE34"/><stop offset=".5" stop-color="#EE2A7B"/><stop offset="1" stop-color="#6228D7"/></linearGradient></defs><rect x="2" y="2" width="20" height="20" rx="5.5" fill="url(#ig)"/><circle cx="12" cy="12" r="4.4" fill="none" stroke="#fff" stroke-width="1.7"/><circle cx="17.5" cy="6.5" r="1.2" fill="#fff"/></svg>',
  phone: '<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M6.6 3.5h2.9l1.6 4.1-2 1.4a12 12 0 0 0 5.9 5.9l1.4-2 4.1 1.6v2.9a1.6 1.6 0 0 1-1.7 1.6A15.7 15.7 0 0 1 5 5.2a1.6 1.6 0 0 1 1.6-1.7z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>',
  mail: '<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><rect x="3" y="5.5" width="18" height="13" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M3.5 6.5 12 13l8.5-6.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>',
  naver: '<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><rect x="2" y="2" width="20" height="20" rx="3" fill="#03C75A"/><path d="M7.2 7h3.1l3.4 5V7h3.1v10h-3.1l-3.4-5v5H7.2z" fill="#fff"/></svg>',
  kakao: '<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><rect x="2" y="2" width="20" height="20" rx="3" fill="#FEE500"/><path d="M12 5.5a4.6 4.6 0 0 0-4.6 4.6c0 3.3 4.6 8.4 4.6 8.4s4.6-5.1 4.6-8.4A4.6 4.6 0 0 0 12 5.5z" fill="#1A1A1A"/><circle cx="12" cy="10.1" r="1.8" fill="#FEE500"/></svg>',
  route: '<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><circle cx="5.5" cy="18.5" r="2" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="18.5" cy="5.5" r="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M7.5 18.5h6a3 3 0 0 0 0-6h-3a3 3 0 0 1 0-6h6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>',
  copy: '<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><rect x="8" y="8" width="12" height="12" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-9A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>',
  share: '<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M12 3.5v11M8.5 7 12 3.5 15.5 7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 11H5.5v9h13v-9H17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
};
---
<Fragment set:html={icons[name]} />
