---
// 첫 화면. 2단계에서 고른 A안, 포스터를 잇는 세로 제목. docs/plan.md 2.1.
import { Picture } from 'astro:assets';
import lake from '../assets/lake.webp';
import lakeReflection from '../assets/lake-reflection.webp';
import { show } from '../content/show';
import WaterBand from './WaterBand.astro';
const variant = 'a';
const titleChars = [...show.title];
const charHtml = titleChars.map((c) => `<span class="title__char">${c}</span>`).join('');
const titleHtml = `<span class="title title--a">${charHtml}</span>`;
---
<header class={`hero hero--${variant}`} id="top">
  <div class="hero__sky">
    <Picture src={lake} widths={[872]} formats={["avif", "webp"]} fallbackFormat="webp" sizes="100vw" alt="" class="hero__painting" data-painting loading="eager" fetchpriority="high" decoding="async" />
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="hero__dusk" aria-hidden="true"></div>
    <div class="curtain" aria-hidden="true"></div>
    {show.texts.stageTimes.act1 && <p class="curtain__time" data-curtain-time>{show.texts.stageTimes.act1}</p>}
    <img src={lakeReflection.src} alt="" data-reflection hidden decoding="async" />
  </div>
  <div class="hero__content">
    <div class="hero__meta">
      <p>{show.company}</p>
      <p>{show.credits.author}</p>
      <p>{show.credits.directing}</p>
    </div>
    <h1 class="hero__title" data-title set:html={titleHtml}></h1>
    {show.originalTitle && <p class="hero__original" aria-label={show.originalTitle}>{show.originalTitle}</p>}
    <p class="hero__when"><span class="hero__when-short">{show.periodShort}</span><span class="hero__when-full">{show.period}</span><span class="hero__when-venue">{show.venue.name}</span></p>
  </div>
  <WaterBand titleHtml={titleHtml} variant={variant} />
</header>

<style is:global>
  /* A안: 세로 제목, 왼쪽 */
  /* 세로 제목은 글자를 블록으로 쌓는다. 세로쓰기 모드는 서브셋 폰트의 세로 메트릭에 기대야 해서 쓰지 않는다 */
  .hero--a .hero__title { left: var(--gutter); bottom: 10px; font-size: var(--fs-title-a); line-height: 1; width: 1em; }
  .hero--a .title__char { display: block; line-height: 1; }
  .hero--a .title__char + .title__char { margin-top: 0.12em; }
  .hero--a .hero__original { left: calc(var(--gutter) + var(--fs-title-a) + 16px); bottom: 14px; writing-mode: vertical-rl; }
  .hero--a .hero__when { right: var(--gutter); bottom: 22px; }
  .hero__when-full { display: none; }
  @media (min-width: 1024px) { .hero__when-short { display: none; } .hero__when-full { display: inline; } }
  .hero--a .hero__meta { position: absolute; left: var(--gutter); top: var(--gutter); }
  @media (min-width: 1024px) {
    .hero--a .hero__meta { top: 24px; }
  }
  .title--a { font-family: 'Seagull Title', var(--font); }
  /* 정지 수면의 거울상은 제목과 같은 자리에 선다 */
  .water__mirror--a { left: var(--gutter); top: 10px; font-size: var(--fs-title-a); font-weight: 700; line-height: 1; width: 1em; }
  .water__mirror--a .title__char { display: block; }
  .water__mirror--a .title__char + .title__char { margin-top: 0.12em; }
  .water__mirror { font-family: 'Seagull Title', var(--font); }
</style>
