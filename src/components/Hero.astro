---
// 첫 화면. variant 'a'는 포스터를 잇는 세로 제목, 'b'는 수평선 위의 가로 제목. docs/plan.md 2장.
import { Picture } from 'astro:assets';
import lakeHouse from '../assets/lake-house.webp';
import lakeReflection from '../assets/lake-reflection.webp';
import { show } from '../content/show';
import WaterBand from './WaterBand.astro';
interface Props { variant: 'a' | 'b' }
const { variant } = Astro.props;
const titleChars = [...show.title];
const titleHtml = variant === 'a'
  ? `<span class="title title--a">${titleChars.map((c) => `<span class="title__char">${c}</span>`).join('')}</span>`
  : `<span class="title title--b">${show.title}</span>`;
---
<header class={`hero hero--${variant}`} id="top">
  <div class="hero__sky">
    <Picture src={lakeHouse} widths={[780]} formats={["avif", "webp"]} fallbackFormat="webp" sizes="100vw" alt="" class="hero__painting" loading="eager" fetchpriority="high" decoding="async" />
    <div class="hero__painting-veil" style="opacity: var(--dusk, 0.3)"></div>
    <div class="curtain" aria-hidden="true"></div>
    <img src={lakeReflection.src} alt="" data-reflection hidden decoding="async" />
  </div>
  <div class="hero__content">
    <div class="hero__meta">
      <p>{show.company}</p>
      <p>{show.credits.author}</p>
      <p>{show.credits.directing}</p>
      {variant === 'b' && <p class="hero__meta-when">{show.periodShort}<br />{show.venue.name}</p>}
    </div>
    <h1 class="hero__title" data-title set:html={titleHtml}></h1>
    {show.originalTitle && <p class="hero__original" aria-label={show.originalTitle}>{show.originalTitle}</p>}
    {variant === 'a' && <p class="hero__when">{show.periodShort}<br />{show.venue.name}</p>}
  </div>
  <WaterBand titleHtml={titleHtml} variant={variant} />
</header>

<style is:global>
  /* A안: 세로 제목, 왼쪽 */
  /* 세로 제목은 글자를 블록으로 쌓는다. 세로쓰기 모드는 서브셋 폰트의 세로 메트릭에 기대야 해서 쓰지 않는다 */
  .hero--a .hero__title { left: var(--gutter); bottom: 12px; font-size: var(--fs-title-a); line-height: 1; width: 1em; }
  .hero--a .title__char { display: block; line-height: 1; }
  .hero--a .title__char + .title__char { margin-top: 16px; }
  .hero--a .hero__original { left: calc(var(--gutter) + var(--fs-title-a) + 20px); bottom: 12px; writing-mode: vertical-rl; }
  .hero--a .hero__when { right: var(--gutter); bottom: calc(var(--button-h) + 52px); }
  .hero--a .hero__meta { position: absolute; left: var(--gutter); top: var(--gutter); }
  /* B안: 가로 제목, 수평선 바로 위 */
  .hero--b .hero__title { left: var(--gutter); bottom: 32px; font-size: var(--fs-title-b); white-space: nowrap; letter-spacing: 0.02em; }
  .hero--b .hero__original { right: var(--gutter); bottom: calc(var(--fs-title-b) + 44px); }
  .hero--b .hero__meta { position: static; }
  .hero--b .hero__meta-when { margin-top: 12px; font-size: var(--fs-caption); }
  @media (min-width: 1024px) {
    .hero--a .hero__meta { top: 24px; }
    .hero--b .hero__meta-when { position: absolute; right: var(--gutter); bottom: calc(var(--button-h) + 52px); text-align: right; margin: 0; white-space: nowrap; }
  }
  .title--a, .title--b { font-family: 'Seagull Title', var(--font); }
  /* 정지 수면의 거울상은 제목과 같은 자리에 선다 */
  .water__mirror--a { left: var(--gutter); top: 12px; font-size: var(--fs-title-a); font-weight: 700; line-height: 1; width: 1em; }
  .water__mirror--a .title__char { display: block; }
  .water__mirror--a .title__char + .title__char { margin-top: 16px; }
  .water__mirror--b { left: var(--gutter); font-size: var(--fs-title-b); font-weight: 700; line-height: 1; white-space: nowrap; letter-spacing: 0.02em; top: 32px; }
  .water__mirror { font-family: 'Seagull Title', var(--font); }
</style>
