---
// 들어가며. 첫 화면 다음, 작품 소개 앞의 글 네 문단(10/17 연출). 제목, 라벨, 막의 시각 없이 작품 소개 본문과 같은 오른쪽 열에 놓는다.
// 마지막 물음은 떼어서 일정 구간의 예매 버튼 위에 있다(texts.bookingLine). 빛은 작품 소개와 같은 한낮의 종이
import { show } from '../content/show';
---
{show.texts.prologue.length > 0 && (
  <section class="section section--prologue" id="prologue" data-light="prologue" aria-label="들어가며">
    <div class="wrap grid">
      <div class="section__body">
        <div class="prose prologue">
          {show.texts.prologue.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>
)}
