---
// 작품 소개. 정오의 빛. 갈래 표기, 소개 글, 대표 대사, 영상, 연출의 말. docs/plan.md 2.1 "작품", 9.5.3.
import { show } from '../content/show';
import Video from './Video.astro';
---
<section class="section section--about" id="about" data-light="about" aria-labelledby="about-title">
  {show.texts.stageTimes.act2 && <p class="stage-time">{show.texts.stageTimes.act2}</p>}
  <div class="wrap grid">
    <hr class="rule rule--section" />
    <header class="section__head">
      <h2 class="section__title" id="about-title" tabindex="-1">작품 소개</h2>
      {show.genreNote && <p class="section__caption">{show.genreNote}</p>}
    </header>
    <div class="section__body">
      <div class="prose prose--lede">
        {show.texts.synopsis.map((p) => <p>{p}</p>)}
      </div>
      <figure class="quote">
        <blockquote><p class="quote__text">{show.texts.mainLine.text}</p></blockquote>
        <figcaption class="quote__source">{show.texts.mainLine.source}</figcaption>
      </figure>
      <Video />
      {show.texts.directorsNote && (
        <div class="note prose">
          <h3 class="note__title">연출의 말</h3>
          {(() => {
            // 글은 받은 그대로 둔다. 길어서 첫 문단과 맺음 한 줄만 펼쳐 두고 가운데는 접는다(10/17 연출 "연출의 말이 너무 길지 않나")
            const ps = show.texts.directorsNote.split('\n\n');
            if (ps.length < 4) return ps.map((p) => <p>{p}</p>);
            return (<>
              <p>{ps[0]}</p>
              <details class="note__more">
                <summary class="action">연출의 말 전부 읽기</summary>
                {ps.slice(1, -1).map((p) => <p>{p}</p>)}
              </details>
              <p class="note__last">{ps[ps.length - 1]}</p>
            </>);
          })()}
        </div>
      )}
    </div>
  </div>
</section>
